#Questo è un .env esempio a sostituire con un vero .env con le variabili con valori adeguati

# Database
DB_USER=nome_utente
DB_PASSWORD=password
DB_NAME=nome_db
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_PASSWORD=password
REDIS_HOST=redis
REDIS_PORT=6379

# IGDB (Twitch)
TWITCH_CLIENT_ID=id_applicativo
TWITCH_CLIENT_SECRET=secret_applicativo

# Mail
EMAIL_CLIENT_ID=utente_mail
EMAIL_CLIENT_SECRET=password_mail

# Sicurezza
OTP_PEPPER=il_tuo_pepper

# LLM
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b