# Database
DB_USER=nome_utente
DB_PASSWORD=password
DB_NAME=nome_db
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_PASSWORD=password
REDIS_HOST=redis
REDIS_PORT=6379

# IGDB (Twitch)
TWITCH_CLIENT_ID=id_applicativo
TWITCH_CLIENT_SECRET=secret_applicativo

# Sicurezza
OTP_PEPPER=il_tuo_pepper
RATE_LIMIT_DISABLED=false

# Mail (Gmail usato per inviare gli OTP: indirizzo + "password per le app", non la password dell'account)
EMAIL_CLIENT_ID=indirizzo@gmail.com
EMAIL_CLIENT_SECRET=password_per_le_app

# LLM
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
